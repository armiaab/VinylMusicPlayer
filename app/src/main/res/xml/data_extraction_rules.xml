<?xml version="1.0" encoding="utf-8"?>
<!-- Backup and device transfer rules for Android 12 and higher. Everything not excluded is kept. -->
<data-extraction-rules>
    <!-- OneDrive: the tokens are encrypted with a device-bound key and cannot be restored
         elsewhere; the item registry and scan position belong to this device's offline copies. -->
    <cloud-backup>
        <exclude domain="sharedpref" path="onedrive_tokens.xml" />
        <exclude domain="sharedpref" path="onedrive_scan.xml" />
        <exclude domain="database" path="onedrive.db" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="onedrive_tokens.xml" />
        <exclude domain="sharedpref" path="onedrive_scan.xml" />
        <exclude domain="database" path="onedrive.db" />
    </device-transfer>
</data-extraction-rules>
